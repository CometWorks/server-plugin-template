<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks that PluginLogger writes messages to the game log verbatim, see README.md.
       Needs the game's Bin64 folder, found the same way as for the plugin build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LoggingDir Condition="'$(LoggingDir)' == ''">$(RepoRoot)Shared/Logging/</LoggingDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(LoggingDir)*.cs" />
    <Reference Include="VRage" HintPath="$(Bin64Dir)VRage.dll" />
    <Reference Include="VRage.Library" HintPath="$(Bin64Dir)VRage.Library.dll" />
  </ItemGroup>
</Project>
